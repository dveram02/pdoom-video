{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": ["vite/client"],
    "paths": { "@engine/*": ["./src/*"] }
  },
  "include": ["src", "../videos"],
  // the P(doom) music video's scenes: kept for reference only, not part of the build
  "exclude": ["src/scenes"]
}
